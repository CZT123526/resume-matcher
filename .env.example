# ============================================================
# 环境变量模板
# 用法：复制本文件为 backend/.env 并填入真实值（backend/.env 已被
# .gitignore 排除，永不提交）。新成员跑通项目只需改带【必填】的项。
# ------------------------------------------------------------
# 格式纪律：
#   1. KEY=值 等号两边不要有空格
#   2. 值中含 # 或空格时，必须用英文双引号包住，如 FOO="a # b"
#   3. 真实密钥绝不写进本文件、绝不出现在任何提交里
# ============================================================

# 后端服务端口（前端固定 5173，此处不要改冲突）
BACKEND_PORT=8000

# 【必填】DeepSeek API 密钥；格式 sk- 开头的字符串
# 获取：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 接口地址（OpenAI 兼容），一般不改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名，以 DeepSeek 控制台公布的 model id 为准
DEEPSEEK_MODEL=deepseek-v4.1-flash

# SQLite 业务库文件路径（相对 backend/ 目录；文件不入库）
DB_PATH=../db/recruiter.db

# ChromaDB 向量库持久化目录（相对 backend/ 目录；不入库）
CHROMA_DIR=../db/chroma
