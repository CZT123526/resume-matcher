# ============================================================
# 环境变量模板
# 用法：复制本文件为 backend/.env 并填入真实值（backend/.env 已被
# .gitignore 排除，永不提交）。
# ------------------------------------------------------------
# 格式纪律：
#   1. KEY=值 等号两边不要有空格
#   2. 值中含 # 或空格时，必须用英文双引号包住，如 FOO="a # b"
#   3. 真实密钥绝不写进本文件、绝不出现在任何提交里
# ============================================================

# 后端服务端口（前端固定 5173，此处不要改冲突）
BACKEND_PORT=8000

# 【离线评测对照组二用，唯一需要你填的密钥】DeepSeek API 密钥，sk- 开头
# 获取：https://platform.deepseek.com → API Keys（先充几块钱，跑一轮实验约几毛钱）
# 用途：仅 tools/run_experiments.py 的 DeepSeek 零样本对照组；系统运行时零 API 依赖
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 【可选】模型 id，不填默认 deepseek-chat（官方稳定别名，恒指向最新版）
# 以 DeepSeek 控制台公布的 model id 为准
# DEEPSEEK_MODEL=deepseek-chat

# SQLite 业务库文件路径（相对 backend/ 目录；文件不入库，一般不改）
DB_PATH=../db/recruiter.db
